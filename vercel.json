{
  "framework": null,
  "buildCommand": null,
  "outputDirectory": ".",
  "installCommand": null,
  "devCommand": null,
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/mangabill/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/mangabill/generated/manifest.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/mangabill/generated/lore/manifest.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/mangabill/generated/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/mangabill/xuanchuan",
      "destination": "/mangabill/index.html"
    },
    {
      "source": "/mangabill/xuanchuan/",
      "destination": "/mangabill/index.html"
    },
    {
      "source": "/mangabill/miku",
      "destination": "/index.html"
    },
    {
      "source": "/mangabill/miku/",
      "destination": "/index.html"
    },
    {
      "source": "/mangabill/analytics",
      "destination": "/analytics.html"
    },
    {
      "source": "/mangabill/analytics/",
      "destination": "/analytics.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
